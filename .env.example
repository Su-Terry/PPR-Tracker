# Alpha Strategist — 環境變數範本 (V1.1)
# 複製此檔為 .env 並填入真實數值。.env 禁止 commit 至 git。

# ── Slack Warden（必填）──────────────────────────────────────────────────────
#
# 前置作業：在 https://api.slack.com/apps 建立一個 Slack App，並完成以下設定：
#
#   1. OAuth & Permissions → Bot Token Scopes 加入：
#      chat:write, channels:history, groups:history, im:history
#      完成後點擊 Install to Workspace → 複製 Bot User OAuth Token（xoxb-...）
#
#   2. Socket Mode → 啟用 Socket Mode
#      App-Level Tokens → Generate an app-level token
#      Scope 選 connections:write → 複製 App-Level Token（xapp-...）
#
#   3. Event Subscriptions → 啟用 Events，Subscribe to bot events 加入：
#      message.channels, message.groups
#
#   4. 將 Bot 加入目標頻道：在 Slack 頻道輸入 /invite @你的BotName
#      頻道 ID 取得方式：右鍵點擊頻道 > View channel details > Copy channel ID（C...）

# Bot OAuth Token（xoxb-... 格式）
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token for Socket Mode（xapp-... 格式）
SLACK_APP_TOKEN=xapp-your-app-token-here

# 接收每日 Warden Report 的頻道 ID（C... 格式）
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ── LLM Compiler（必填）──────────────────────────────────────────────────────
#
# Google Gemini API Key（用於 generate_daily_report / generate_adhoc_analysis）
# 取得：https://aistudio.google.com/app/apikey
# 使用模型：gemini-2.0-flash（可在 src/llm_compiler.py 的 _MODEL 常數修改）
# 查詢可用模型：uv run python -c "from google import genai; import os; from dotenv import load_dotenv; load_dotenv(); [print(m.name) for m in genai.Client(api_key=os.getenv('GEMINI_API_KEY')).models.list() if 'generateContent' in (m.supported_actions or [])]"
GEMINI_API_KEY=your_gemini_api_key_here
